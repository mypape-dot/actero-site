{
  "name": "actero-unbound-do-not-deploy",
  "main": "../worker.js",
  "compatibility_date": "2025-09-27",
  "account_id": "UNBOUND_REQUIRES_OWNER_APPROVAL",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "env": {
    "staging": {
      "name": "actero-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "SHOPIFY_CHECKOUT_ENABLED": "false",
        "SHOPIFY_PAYMENT_MODE": "test",
        "RECOVERY_REQUIRED": "true",
        "RECOVERY_PAGE_URL": "https://actero-staging-ui.pages.dev/recuperare.html",
        "ACTERO_ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://actero-staging-ui.pages.dev",
        "SHOPIFY_SHOP_DOMAIN": "UNBOUND_STAGING_SHOP",
        "SHOPIFY_VARIANT_ID": "UNBOUND_STAGING_VARIANT"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "actero-staging-db",
          "database_id": "UNBOUND_REQUIRES_SEPARATE_STAGING_DATABASE",
          "migrations_dir": "./migrations"
        }
      ]
    }
  }
}
